{
  "id": "app.fotema.Fotema",
  "runtime": "org.gnome.Platform",
  "runtime-version": "51",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable",
    "org.freedesktop.Sdk.Extension.llvm22"
  ],
  "command": "fotema",
  "finish-args": [
    "--device=dri",
    "--share=ipc",
    "--share=network",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--socket=pulseaudio",
    "--env=RUST_BACKTRACE=0",
    "--env=RUST_LOG=fotema=info,fotema_core::thumbnailify=warn,relm4=warn,glycin=warn"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin:/usr/lib/sdk/llvm22/bin",
    "prepend-ld-library-path": "/usr/lib/sdk/llvm22/lib",
    "env": {
        "AWS_LC_SYS_NO_JITTER_ENTROPY": "1"

    }
  },
  "cleanup": [
    "/include",
    "/lib/cmake",
    "/lib/girepository-1.0",
    "/lib/pkgconfig",
    "/share/gir-1.0",
    "*.la",
    "*.a"
  ],
  "modules": [
    "modules/libshumate.json",
    "modules/opencv.json",
    "modules/libonnxruntime.json",
    {
      "name": "fotema",
      "buildsystem": "meson",
      "builddir": true,
      "run-tests": false,
      "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin:/usr/lib/sdk/llvm22/bin",
        "prepend-ld-library-path": "/usr/lib/sdk/llvm22/lib",
        "env": {
          "OPENCV_INCLUDE_PATHS": "/app/include/opencv5",
          "LIBCLANG_PATH": "/usr/lib/sdk/llvm22/lib",
          "ORT_STRATEGY": "system"
        }
      },
      "config-opts": [
        "-Dprofile=default",
        "-Dsandboxed=true"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/blissd/fotema.git",
          "tag": "v2.5.0",
          "commit": "50780136d762bf2e4ae45e80914934849811347b"
        },
        "cargo-sources.json"
      ]
    }
  ]
}
